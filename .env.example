# Đổi tên file này thành .env rồi điền thông tin (chỉ cần khi chạy trên máy tính)
TELEGRAM_BOT_TOKEN=dán_token_của_BotFather_vào_đây
GEMINI_API_KEY=dán_API_key_Gemini_vào_đây

# ---- Tuỳ chọn (có thể để nguyên) ----
# ID Telegram được phép dùng bot, cách nhau dấu phẩy. Để trống = người đầu tiên bấm /start là chủ bot
ALLOWED_USERS=
BOT_NAME=3X – Săn tin nóng
CHECK_INTERVAL=60
RSS_EVERY=60
GNEWS_EVERY=240
MAX_AGE_HOURS=12
INIT_COUNT=5
MAX_PER_CYCLE=40
TRUSTED_ONLY=1
LINK_PREVIEW=0
GEMINI_MODEL=gemini-flash-lite-latest
